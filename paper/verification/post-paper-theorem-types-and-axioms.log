PrimeFactorOscillations.densityRatio_thetaClock_two_sided_power_excursions_of_zero {rho : ℂ}
  (hZero : riemannZeta rho = 0) (hHalf : 1 / 2 < rho.re) (hOne : rho.re < 1) {b : ℝ} (hLower : 1 - rho.re < b)
  (hbHalf : b ≤ 1 / 2) (alpha : ℝ) (ha : 0 < alpha) :
  have L := fun x => Real.eulerMascheroniConstant + Real.log (Real.log (Chebyshev.theta x));
  have r := fun x => ⌊alpha * L x⌋₊;
  have E := fun x =>
    L x *
      (↑(PrimeFactorUnimodality.densityRatio (PrimeFactorUnimodality.primesBelow (⌊x⌋₊ + 1)) (r x)) -
        Nat.factorialConvolution PrimeFactorOscillations.primeProfileRealCoefficient (r x - 1) (L x) /
          Nat.factorialConvolution PrimeFactorOscillations.primeProfileRealCoefficient (r x) (L x));
  have V := fun x =>
    1 < Chebyshev.theta x ∧
      2 ≤ L x ∧
        0 < ↑(PrimeFactorUnimodality.weightEsymm (PrimeFactorUnimodality.primesBelow (⌊x⌋₊ + 1)) (r x)) ∧
          0 < Nat.factorialConvolution PrimeFactorOscillations.primeProfileRealCoefficient (r x) (L x);
  ∀ (X A : ℝ), (∃ x, max X 3 < x ∧ V x ∧ A * x ^ (-b) < E x) ∧ ∃ x, max X 3 < x ∧ V x ∧ A * x ^ (-b) < -E x
