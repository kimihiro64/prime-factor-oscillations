PrimeFactorOscillations.exists_eventually_densityRatio_signed_thetaClock_margin (a B : ℝ) (ha : 0 < a) (haB : a ≤ B) :
  ∃ K,
    0 ≤ K ∧
      ∀ᶠ (x : ℝ) in Filter.atTop,
        have L := Real.eulerMascheroniConstant + Real.log (Real.log (Chebyshev.theta x));
        have F := Robin1984.nicolasLogMertensOscillation x;
        1 < Chebyshev.theta x ∧
          2 ≤ L ∧
            ∀ (r : ℕ),
              a ≤ ↑r / L →
                ↑r / L ≤ B →
                  0 < ↑(PrimeFactorUnimodality.weightEsymm (PrimeFactorUnimodality.primesBelow (⌊x⌋₊ + 1)) r) ∧
                    0 < Nat.factorialConvolution PrimeFactorOscillations.primeProfileRealCoefficient r L ∧
                      have E :=
                        L *
                          (↑(PrimeFactorUnimodality.densityRatio (PrimeFactorUnimodality.primesBelow (⌊x⌋₊ + 1)) r) -
                            Nat.factorialConvolution PrimeFactorOscillations.primeProfileRealCoefficient (r - 1) L /
                              Nat.factorialConvolution PrimeFactorOscillations.primeProfileRealCoefficient r L);
                      (0 ≤ F → a / 2 * F - K / (a * x) ≤ E) ∧ (F ≤ 0 → E ≤ a / 2 * F + K / (a * x))
