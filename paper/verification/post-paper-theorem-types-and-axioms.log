                              ∑ p ∈ PrimeFactorOscillations.primeProfilePrefixSet N,
                                Real.log (1 + PrimeFactorOscillations.primeProfileWeight ↑p);
                            Set.Icc (↑r / s - A) (↑r / s + A) B →
