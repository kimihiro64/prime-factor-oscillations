PrimeFactorOscillations.doubleExponentialReversalBounds : PrimeFactorOscillations.DoubleExponentialReversalBounds
'PrimeFactorOscillations.doubleExponentialReversalBounds' depends on axioms: [propext, Classical.choice, Quot.sound]
PrimeFactorOscillations.publicDoubleExponentialReversalBounds :
  have density := fun eta k i =>
    have p := Nat.nth Nat.Prime i;
    eta p *
      List.foldr (fun ell f t => Nat.rec ((1 - eta ell) * f 0) (fun j x => (1 - eta ell) * f (j + 1) + eta ell * f j) t)
        (fun t => Nat.rec 1 (fun x x_1 => 0) t) ((Finset.filter Nat.Prime (Finset.range p)).sort fun a b => a ≤ b)
        (k - 1);
  have ordinary := density fun p => 1 / ↑p;
  have odd := density fun p => if p = 2 then 0 else (↑p - 2) / (↑p - 1) ^ 2;
  have witnesses := fun f m =>
    ∃ descent ascent,
      (∀ (j : Fin m), descent j < ascent j ∧ f (descent j + 1) < f (descent j) ∧ f (ascent j) < f (ascent j + 1)) ∧
        ∀ (i j : Fin m), i < j → ascent i + 1 < descent j;
  have maximum := fun f N => witnesses f N ∧ ∀ (m : ℕ), witnesses f m → m ≤ N;
  have bounds := fun f k a epsilon =>
    ∃ N, maximum f N ∧ Real.exp (Real.exp (a * ↑k)) ≤ ↑N ∧ ↑N ≤ Real.exp (Real.exp ((1 / 3 + epsilon) * ↑k));
  ∃ a,
    0 < a ∧
      ∀ (epsilon : ℝ),
        0 < epsilon → ∃ K, 1 ≤ K ∧ ∀ (k : ℕ), K ≤ k → bounds (ordinary k) k a epsilon ∧ bounds (odd k) k a epsilon
'PrimeFactorOscillations.publicDoubleExponentialReversalBounds' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
