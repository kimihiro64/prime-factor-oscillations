  (hULow : ∀ i ∈ s, 1 ≤ U i - g i) (hUHigh : ∀ i ∈ s, U i - g i ≤ ↑H + 1) (hDelta : ∀ i ∈ s, delta ≤ R i - U i) :
  ↑s.card * (↑M * delta - 1) ≤
    ∑ i ∈ s,
      (↑(PrimeFactorOscillations.tiltAscentSet H M (R i) (g i)).card -
        ↑(PrimeFactorOscillations.tiltAscentSet H M (U i) (g i)).card)
'PrimeFactorOscillations.tiltAscentSet_sum_lower' depends on axioms: [propext, Classical.choice, Quot.sound]
