                                Real.exp (Real.exp (L - Real.eulerMascheroniConstant)) ≤ D * ↑N →
                                  0 <
                                      ↑(PrimeFactorUnimodality.weightEsymm (PrimeFactorUnimodality.primesBelow (N + 1))
                                          r) ∧
                                    (K * Real.log ↑N <
