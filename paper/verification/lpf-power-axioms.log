PrimeFactorOscillations.LPF.fullOrbit_defect_power_bound_of_density_zero (M : ℕ) (S : Finset ℕ) (hM : 8 ≤ M)
  (hDensity :
    Filter.Tendsto
      (fun j =>
        ↑(PrimeFactorOscillations.LPF.inputPrimePrefix (PrimeFactorOscillations.LPF.lpfDensityCutoff M j) \
                PrimeFactorOscillations.LPF.fullOrbit S j).card /
          (↑(PrimeFactorOscillations.LPF.lpfDensityCutoff M j) /
            Real.log ↑(PrimeFactorOscillations.LPF.lpfDensityCutoff M j)))
      Filter.atTop (nhds 0)) :
  ∃ K,
    0 < K ∧
      ∀ᶠ (j : ℕ) in Filter.atTop,
        ↑(PrimeFactorOscillations.LPF.inputPrimePrefix (PrimeFactorOscillations.LPF.lpfDensityCutoff M j) \
                PrimeFactorOscillations.LPF.fullOrbit S j).card ≤
          K * ↑(PrimeFactorOscillations.LPF.lpfDensityCutoff M j) ^ (79 / 80)
'PrimeFactorOscillations.LPF.fullOrbit_defect_power_bound_of_density_zero' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]

PrimeFactorOscillations.LPF.exists_fullOrbit_dense_power_bound :
  ∃ eta,
    0 < eta ∧
      ∀ᶠ (M : ℕ) in Filter.atTop,
        ∀ (S : Finset ℕ),
          ↑(PrimeFactorOscillations.LPF.inputPrimePrefix M \ S).card ≤ eta * (↑M / Real.log ↑M) →
            ∃ K,
              0 < K ∧
                ∀ᶠ (j : ℕ) in Filter.atTop,
                  ↑(PrimeFactorOscillations.LPF.inputPrimePrefix (PrimeFactorOscillations.LPF.lpfDensityCutoff M j) \
                          PrimeFactorOscillations.LPF.fullOrbit S j).card ≤
                    K * ↑(PrimeFactorOscillations.LPF.lpfDensityCutoff M j) ^ (79 / 80)
