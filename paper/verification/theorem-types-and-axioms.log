PrimeFactorOscillations.exists_affine_arithmetic_rate_recovers_full_gap_class :
  ∃ J V,
    2 ≤ J ∧
      PrimeFactorOscillations.primeGapFrequencyExponent J = 1 ∧
        ∀ (F : PrimeFactorOscillations.AffineSumFamily),
          V ≤ F.arity →
            ∃ d n,
              (∀ (k i : ℕ),
                  Filter.Tendsto
                    (fun N =>
                      PrimeFactorOscillations.primePairProbability N fun ab =>
                        PrimeFactorUnimodality.IsKthDistinctPrimeFactor (F.value ab.1 ab.2).natAbs k
                          (PrimeFactorUnimodality.primeAt i))
                    Filter.atTop (nhds (d k i))) ∧
                (∃ K, ∀ (k : ℕ), K ≤ k → PrimeFactorOscillations.HasReversalNumber (d k) (n k)) ∧
                  1 / Filter.limsup (fun k => Real.log (Real.log (3 + ↑(n k))) / ↑k) Filter.atTop - ↑F.arity = ↑J
