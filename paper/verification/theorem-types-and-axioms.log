PrimeFactorOscillations.publicAffinePrimePairSpectrum :
  have prime := fun i => Nat.nth Nat.Prime i;
  have gapCount := fun H X => {i ∈ Finset.range X | prime i ≤ X ∧ prime (i + 1) - prime i ≤ H}.card;
  have gamma := fun H =>
    Filter.limsup (fun X => Real.log (Real.log (3 + ↑(gapCount H X))) / Real.log (Real.log ↑X)) Filter.atTop;
  have witnesses := fun f j =>
    ∃ descent ascent,
      (∀ (t : Fin j), descent t < ascent t ∧ f (descent t + 1) < f (descent t) ∧ f (ascent t) < f (ascent t + 1)) ∧
        ∀ (s t : Fin j), s < t → ascent s + 1 < descent t;
  have maximum := fun f j => witnesses f j ∧ ∀ (h : ℕ), witnesses f h → h ≤ j;
  ∀ (m : ℕ),
    0 < m →
      ∀ (c shift : Fin m → ℤ),
        (∀ (j : Fin m), 0 < c j) →
          (∀ (i j : Fin m), ¬i = j → ¬c i * shift j = c j * shift i) →
            have value := fun a b => ∏ j, (c j * (↑a + ↑b) + shift j);
            ∃ density counts,
              (∀ (k : ℕ),
                  1 ≤ k →
                    ∀ (i : ℕ),
                      Filter.Tendsto
                        (fun X =>
                          ↑{ab ∈ X.primesLE ×ˢ X.primesLE |
                                  Nat.Prime (prime i) ∧
                                    prime i ∣ (value ab.1 ab.2).natAbs ∧
                                      ¬(value ab.1 ab.2).natAbs = 0 ∧
                                        {ell ∈ (value ab.1 ab.2).natAbs.primeFactors | ell < prime i}.card =
                                          k - 1}.card /
                            ↑X.primeCounting ^ 2)
                        Filter.atTop (nhds (density k i))) ∧
                (∀ (k : ℕ), 1 ≤ k → maximum (density k) (counts k)) ∧
                  Filter.limsup (fun k => Real.log (Real.log (3 + ↑(counts k))) / ↑k) Filter.atTop =
                      sSup (Set.range fun j => gamma (j + 2) / (↑j + 2 + ↑m)) ∧
                    0 < sSup (Set.range fun j => gamma (j + 2) / (↑j + 2 + ↑m))
