PrimeFactorOscillations.AffineSumFamily.exists_sharp_arithmetic_reversal_rate_all_ranks
  (F : PrimeFactorOscillations.AffineSumFamily) :
  ∃ d n,
    (∀ (k i : ℕ),
        Filter.Tendsto
          (fun N =>
            PrimeFactorOscillations.primePairProbability N fun ab =>
              PrimeFactorUnimodality.IsKthDistinctPrimeFactor (F.value ab.1 ab.2).natAbs k
                (PrimeFactorUnimodality.primeAt i))
          Filter.atTop (nhds (d k i))) ∧
      (∀ (k : ℕ), PrimeFactorOscillations.HasReversalNumber (d k) (n k)) ∧
        Filter.limsup (fun k => Real.log (Real.log (3 + ↑(n k))) / ↑k) Filter.atTop =
            PrimeFactorOscillations.primeGapSpectrum ↑F.arity ∧
          0 < PrimeFactorOscillations.primeGapSpectrum ↑F.arity
