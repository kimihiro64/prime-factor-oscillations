PrimeFactorOscillations.ascent_above_one_fifth_forces_twins (b : ℝ) (hb : 1 / 5 < b) :
  ∃ K Q,
    2 ≤ K ∧
      3 ≤ Q ∧
        ∀ (k : ℕ),
          K ≤ k →
            ∀ (i : ℕ),
              Q ≤ PrimeFactorUnimodality.primeAt i →
                b * ↑k ≤ Real.log (Real.log ↑(PrimeFactorUnimodality.primeAt i - 1)) →
                  PrimeFactorOscillations.ordinaryDensity k i < PrimeFactorOscillations.ordinaryDensity k (i + 1) ∨
                      PrimeFactorOscillations.genericOddDensity k i <
