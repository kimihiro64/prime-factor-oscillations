theorem expansion (y : Fin 6 -> Real) (j : Fin 5) :
    column y (index j) = Finset.univ.sum (fun i : Fin 80 =>
      (coefficient (index j) i : Real) * orbitBasis y i) := by
  refine Fin.cases (expansion_30 y) ?_ j
  intro j
  refine Fin.cases (expansion_31 y) ?_ j
  intro j
  refine Fin.cases (expansion_32 y) ?_ j
  intro j
  refine Fin.cases (expansion_33 y) ?_ j
  intro j
  refine Fin.cases (expansion_34 y) ?_ j
  intro j
  exact Fin.elim0 j

