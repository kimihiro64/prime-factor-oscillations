private theorem expansion_32 (y : Fin 6 -> Real) :
    column y 32 = Finset.univ.sum (fun i : Fin 80 =>
      (coefficient 32 i : Real) * orbitBasis y i) := by
  change 6 * Finset.univ.sum (fun u : Fin 6 => let z := permute y u; (7 * mass z - 2) * (quadratic z 32) ^ 2) =
    Finset.univ.sum (fun i : Fin 80 => (coefficient 32 i : Real) * orbitBasis y i)
  rw [coordinate_vector y]
  generalize y 0 = a
  generalize y 1 = b
  generalize y 2 = c
  generalize y 3 = d
  generalize y 4 = e
  generalize y 5 = f
