private theorem expansion_13 (y : Fin 6 -> Real) :
    column y 13 = Finset.univ.sum (fun i : Fin 80 =>
      (coefficient 13 i : Real) * orbitBasis y i) := by
  change 42 * Finset.univ.sum (fun u : Fin 6 => let z := permute y u; (mass z - z 0) * (quadratic z 13) ^ 2) =
    Finset.univ.sum (fun i : Fin 80 => (coefficient 13 i : Real) * orbitBasis y i)
  rw [coordinate_vector y]
  generalize y 0 = a
  generalize y 1 = b
  generalize y 2 = c
  generalize y 3 = d
  generalize y 4 = e
  generalize y 5 = f
