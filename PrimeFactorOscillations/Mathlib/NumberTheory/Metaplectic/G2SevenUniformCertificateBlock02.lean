/-- Exact polynomial identities in one bounded certificate block. -/
theorem expansion (y : Fin 6 -> Real) (j : Fin 5) :
    column y (index j) = Finset.univ.sum (fun i : Fin 80 =>
      (coefficient (index j) i : Real) * orbitBasis y i) := by
  refine Fin.cases (expansion_10 y) ?_ j
  intro j
  refine Fin.cases (expansion_11 y) ?_ j
  intro j
  refine Fin.cases (expansion_12 y) ?_ j
  intro j
  refine Fin.cases (expansion_13 y) ?_ j
  intro j
  refine Fin.cases (expansion_14 y) ?_ j
  intro j
  exact Fin.elim0 j

