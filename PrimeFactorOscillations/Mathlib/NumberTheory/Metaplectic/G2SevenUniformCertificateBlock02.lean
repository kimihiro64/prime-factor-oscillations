import PrimeFactorOscillations.Mathlib.NumberTheory.Metaplectic.G2SevenUniformCertificateData

/-!
# Exact polynomial certificate block 02

A bounded group of polynomial identities for the full cyclic stability
certificate. Each proof selects its literal finite column before expansion.
-/

set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 4096
set_option maxHeartbeats 4000000

namespace Metaplectic.G2Seven.Uniform.Certificate.Block02

/-- The bounded block's index in the full certificate. -/
def index (j : Fin 5) : Fin 79 :=
  Fin.mk (j.val + 10) (by
    have h := Nat.add_lt_add_right j.isLt 10
    exact lt_of_lt_of_le h (by decide))

private theorem empty_sum (f : Fin 0 -> Real) :
    Finset.univ.sum f = 0 := by
  apply Finset.sum_eq_zero
  intro i _
  exact Fin.elim0 i

private theorem coordinate_vector (y : Fin 6 -> Real) :
    y = ![y 0, y 1, y 2, y 3, y 4, y 5] := by
  funext i
  fin_cases i <;> rfl

private theorem expansion_10 (y : Fin 6 -> Real) :
    column y 10 = Finset.univ.sum (fun i : Fin 80 =>
      (coefficient 10 i : Real) * orbitBasis y i) := by
