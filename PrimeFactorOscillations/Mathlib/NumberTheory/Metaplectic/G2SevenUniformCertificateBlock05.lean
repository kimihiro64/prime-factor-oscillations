  intro j
  refine Fin.cases (expansion_26 y) ?_ j
  intro j
  refine Fin.cases (expansion_27 y) ?_ j
  intro j
  refine Fin.cases (expansion_28 y) ?_ j
  intro j
  refine Fin.cases (expansion_29 y) ?_ j
  intro j
  exact Fin.elim0 j

