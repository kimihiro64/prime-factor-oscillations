/-- Exact polynomial identities in one bounded certificate block. -/
theorem expansion (y : Fin 6 -> Real) (j : Fin 5) :
    column y (index j) = Finset.univ.sum (fun i : Fin 80 =>
      (coefficient (index j) i : Real) * orbitBasis y i) := by
  refine Fin.cases (expansion_15 y) ?_ j
  intro j
  refine Fin.cases (expansion_16 y) ?_ j
  intro j
  refine Fin.cases (expansion_17 y) ?_ j
  intro j
  refine Fin.cases (expansion_18 y) ?_ j
  intro j
  refine Fin.cases (expansion_19 y) ?_ j
  intro j
  exact Fin.elim0 j

