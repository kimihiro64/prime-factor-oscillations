import PrimeFactorOscillations.Helpers.PrimePowerConductorReduction

/-!
# Exact two-power character conductors

The genuine kernel of reduction from units modulo 2^(a+3) to units modulo
8 is generated by the square of the unit 5. Its exact cardinality proves
that every quadratic character factors through 8, with all phases intact.
The actual unit-group exponent is also identified for every a.
-/

set_option autoImplicit false
set_option Elab.async false

noncomputable section

namespace PrimeFactorOscillations.TwoPowerCharacterConductor

open PrimePowerReturnSpectrum

def fiveUnit (a : Nat) : Units (ZMod (2 ^ (a + 3))) :=
  ((ZMod.isUnit_iff_coprime 5 (2 ^ (a + 3))).mpr
    ((by decide : Nat.Coprime 5 2).pow_right (a + 3))).unit

theorem fiveUnit_val (a : Nat) :
    Units.val (fiveUnit a) = (5 : ZMod (2 ^ (a + 3))) :=
  IsUnit.unit_spec _

theorem fiveUnit_order (a : Nat) :
    orderOf (fiveUnit a) = 2 ^ (a + 1) := by
  rw [<- orderOf_injective _ Units.coeHom_injective (fiveUnit a),
    Units.coeHom_apply, fiveUnit_val]
  exact ZMod.orderOf_five (a + 1)

theorem fiveUnit_square_order (a : Nat) :
    orderOf (fiveUnit a ^ 2) = 2 ^ a := by
  rw [orderOf_pow, fiveUnit_order,
    Nat.gcd_eq_right (dvd_pow_self 2 (by omega : Not (a + 1 = 0))),
    pow_succ, Nat.mul_div_cancel _ (by decide : 0 < 2)]

theorem reduction_eight_kernel (a : Nat) :
    (conductorMap 2 a 2).ker = Subgroup.zpowers (fiveUnit a ^ 2) := by
  apply Eq.symm
  apply Subgroup.eq_of_le_of_card_ge
  . apply Subgroup.zpowers_le.mpr
    change conductorMap 2 a 2 (fiveUnit a ^ 2) = 1
    apply Units.ext
    change ZMod.castHom (conductor_dvd 2 a 2) (ZMod 8)
      (Units.val (fiveUnit a ^ 2)) = 1
    rw [Units.val_pow_eq_pow_val, map_pow, fiveUnit_val]
    have hFive : ZMod.castHom (conductor_dvd 2 a 2) (ZMod 8)
        (5 : ZMod (2 ^ (a + 3))) = 5 := map_natCast _ 5
    rw [hFive]
    decide
  . rw [conductor_kernel_card 2 a 2 Nat.prime_two, Nat.card_zpowers,
      fiveUnit_square_order]

theorem quadratic_factorsThrough_eight (a : Nat)
    (chi : DirichletCharacter Complex (2 ^ (a + 3)))
    (hSquare : forall u : Units (ZMod (2 ^ (a + 3))),
      chi (Units.val u) ^ 2 = 1) :
    chi.FactorsThrough 8 := by
  apply (DirichletCharacter.factorsThrough_iff_ker_unitsMap
    (conductor_dvd 2 a 2)).mpr
  change (conductorMap 2 a 2).ker <= chi.toUnitHom.ker
  rw [reduction_eight_kernel]
  apply Subgroup.zpowers_le.mpr
  change chi.toUnitHom (fiveUnit a ^ 2) = 1
  rw [map_pow]
  apply Units.ext
  simpa only [Units.val_pow_eq_pow_val, MulChar.coe_toUnitHom, Units.val_one]
    using hSquare (fiveUnit a)

theorem quadratic_conductor_dvd_eight (a : Nat)
    (chi : DirichletCharacter Complex (2 ^ (a + 3)))
    (hSquare : forall u : Units (ZMod (2 ^ (a + 3))),
      chi (Units.val u) ^ 2 = 1) :
    Dvd.dvd chi.conductor 8 := by
  exact DirichletCharacter.conductor_dvd_of_mem_conductorSet chi
    (quadratic_factorsThrough_eight a chi hSquare)

theorem nonprincipal_not_factorsThrough_two {q : Nat} [NeZero q]
    (chi : DirichletCharacter Complex q) (hChi : Not (chi = 1)) :
    Not (chi.FactorsThrough 2) := by
  intro hFactor
  choose hd psi hEquality using hFactor
  have hCases : forall v : Units (ZMod 2), v = 1 := by decide
  apply hChi
  apply MulChar.eq_one_iff.mpr
  intro u
  have hHom : chi.toUnitHom u = 1 := by
    rw [hEquality, DirichletCharacter.changeLevel_toUnitHom]
    change psi.toUnitHom (ZMod.unitsMap hd u) = 1
    rw [hCases (ZMod.unitsMap hd u), map_one]
  have hValues := congrArg (fun z : Units Complex => (z : Complex)) hHom
  simpa only [MulChar.coe_toUnitHom, Units.val_one] using hValues

theorem nonprincipal_conductor_four_or_eight {q : Nat} [NeZero q]
    (hTwo : Dvd.dvd 2 q) (chi : DirichletCharacter Complex q)
    (hDiv : Dvd.dvd chi.conductor 8) (hChi : Not (chi = 1)) :
    Or (chi.conductor = 4) (chi.conductor = 8) := by
  choose k hk using (Nat.dvd_prime_pow Nat.prime_two).mp
    (show Dvd.dvd chi.conductor (2 ^ 3) from hDiv)
  have hkTwo : 2 <= k := by
    by_contra hn
    have hDivTwo : Dvd.dvd chi.conductor 2 := by
      rw [hk.right]
      exact pow_dvd_pow 2 (by omega : k <= 1)
    exact nonprincipal_not_factorsThrough_two chi hChi
      ((DirichletCharacter.mem_conductorSet_iff_conductor_dvd chi hTwo).mpr hDivTwo)
  have hCases : Or (k = 2) (k = 3) := by omega
  rcases hCases with h | h
  . exact Or.inl (hk.right.trans (congrArg (fun n : Nat => 2 ^ n) h))
  . exact Or.inr (hk.right.trans (congrArg (fun n : Nat => 2 ^ n) h))

theorem nonprincipal_conductor_four
    (chi : DirichletCharacter Complex 4) (hChi : Not (chi = 1)) :
    chi.conductor = 4 := by
  have hDiv := chi.conductor_dvd_level
  have hDivEight : Dvd.dvd chi.conductor 8 := dvd_trans hDiv (by decide)
  rcases nonprincipal_conductor_four_or_eight (by decide : Dvd.dvd 2 4)
      chi hDivEight hChi with h | h
  . exact h
  . rw [h] at hDiv
    norm_num at hDiv

theorem even_nonprincipal_not_factorsThrough_four (a : Nat)
    (chi : DirichletCharacter Complex (2 ^ (a + 3)))
    (hEven : chi (-1 : ZMod (2 ^ (a + 3))) = 1)
    (hChi : Not (chi = 1)) :
    Not (chi.FactorsThrough 4) := by
  intro hFactor
  choose hd psi hEquality using hFactor
  have hMinus : ZMod.unitsMap hd (-1 : Units (ZMod (2 ^ (a + 3)))) =
      (-1 : Units (ZMod 4)) := by
    apply Units.ext
    change ZMod.castHom hd (ZMod 4) (-1) = -1
    rw [map_neg, map_one]
  have hChiSign : chi.toUnitHom (-1 : Units (ZMod (2 ^ (a + 3)))) = 1 := by
    apply Units.ext
    change chi (-1 : ZMod (2 ^ (a + 3))) = 1
    exact hEven
  have hPsiSign : psi.toUnitHom (-1 : Units (ZMod 4)) = 1 := by
    rw [hEquality, DirichletCharacter.changeLevel_toUnitHom] at hChiSign
    change psi.toUnitHom (ZMod.unitsMap hd (-1)) = 1 at hChiSign
    rwa [hMinus] at hChiSign
  have hCases : forall v : Units (ZMod 4), Or (v = 1) (v = -1) := by decide
  apply hChi
  apply MulChar.eq_one_iff.mpr
  intro u
  have hHom : chi.toUnitHom u = 1 := by
    rw [hEquality, DirichletCharacter.changeLevel_toUnitHom]
    change psi.toUnitHom (ZMod.unitsMap hd u) = 1
    rcases hCases (ZMod.unitsMap hd u) with h | h
    . rw [h, map_one]
    . rw [h, hPsiSign]
  have hValues := congrArg (fun z : Units Complex => (z : Complex)) hHom
  simpa only [MulChar.coe_toUnitHom, Units.val_one] using hValues

theorem even_quadratic_nonprincipal_conductor (a : Nat)
    (chi : DirichletCharacter Complex (2 ^ (a + 3)))
    (hSquare : forall u : Units (ZMod (2 ^ (a + 3))),
      chi (Units.val u) ^ 2 = 1)
    (hEven : chi (-1 : ZMod (2 ^ (a + 3))) = 1)
    (hChi : Not (chi = 1)) :
    chi.conductor = 8 := by
  have hDiv := quadratic_conductor_dvd_eight a chi hSquare
  have hNot := even_nonprincipal_not_factorsThrough_four a chi hEven hChi
  apply Classical.byContradiction
  intro hNe
  choose k hk using (Nat.dvd_prime_pow Nat.prime_two).mp
    (show Dvd.dvd chi.conductor (2 ^ 3) from hDiv)
  have hkLe : k <= 2 := by
    have hkNe : Not (k = 3) := by
      intro heq
      exact hNe (hk.right.trans (congrArg (fun n : Nat => 2 ^ n) heq))
    omega
  apply hNot
  apply (DirichletCharacter.mem_conductorSet_iff_conductor_dvd chi
    (conductor_dvd 2 (a + 1) 1)).mpr
  rw [hk.right]
  exact pow_dvd_pow 2 hkLe

theorem unit_exponent (a : Nat) :
    Monoid.exponent (Units (ZMod (2 ^ (a + 3)))) = 2 ^ (a + 1) := by
  let G := Units (ZMod (2 ^ (a + 3)))
  have hCard : Nat.card G = 2 ^ (a + 2) := by
    simp only [G, Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]
    rw [Nat.totient_prime_pow_succ Nat.prime_two (a + 2)]
    simp
  have hDiv : Dvd.dvd (Monoid.exponent G) (2 ^ (a + 2)) := by
    rw [<- hCard]
    exact Group.exponent_dvd_nat_card
  have hNot : Not (Monoid.exponent G = 2 ^ (a + 2)) := by
    intro h
    have hCyclic : IsCyclic G :=
      IsCyclic.iff_exponent_eq_card.mpr (h.trans hCard.symm)
    have hLe := (ZMod.isCyclic_units_two_pow_iff (a + 3)).mp hCyclic
    omega
  choose k hk using (Nat.dvd_prime_pow Nat.prime_two).mp hDiv
  have hkLe : k <= a + 1 := by
    have hkNe : Not (k = a + 2) := by
      intro heq
      exact hNot (hk.right.trans (congrArg (fun n : Nat => 2 ^ n) heq))
    omega
  apply Nat.le_antisymm
  . rw [hk.right]
    gcongr
  . apply Nat.le_of_dvd (Nat.pos_of_ne_zero Monoid.exponent_ne_zero_of_finite)
    rw [<- fiveUnit_order a]
    exact Monoid.order_dvd_exponent (fiveUnit a)

theorem shortened_image_card_le_two (a : Nat) :
    Nat.card ((powMonoidHom (2 ^ (a + 1)) :
      MonoidHom (Units (ZMod (2 ^ (a + 4))))
        (Units (ZMod (2 ^ (a + 4))))).range) <= 2 := by
  let G := Units (ZMod (2 ^ (a + 4)))
  let f : MonoidHom G G := powMonoidHom (2 ^ (a + 1))
  let K := (conductorMap 2 (a + 1) 2).ker
  have hEight : forall v : Units (ZMod 8), v ^ 2 = 1 := by decide
  have hEvenPower (v : Units (ZMod 8)) : v ^ (2 ^ (a + 1)) = 1 := by
    rw [pow_succ, Nat.mul_comm, pow_mul, hEight, one_pow]
  have hLe : f.range <= K := by
    intro y hy
    choose u hu using hy
    change conductorMap 2 (a + 1) 2 y = 1
    rw [<- hu]
    change conductorMap 2 (a + 1) 2 (u ^ (2 ^ (a + 1))) = 1
    rw [map_pow]
    exact hEvenPower (conductorMap 2 (a + 1) 2 u)
  have hK : K = Subgroup.zpowers (fiveUnit (a + 1) ^ 2) :=
    reduction_eight_kernel (a + 1)
  let : IsCyclic K := by rw [hK]; infer_instance
  let : IsCyclic f.range :=
    isCyclic_of_injective (Subgroup.inclusion hLe) (Subgroup.inclusion_injective hLe)
  have hDiv : Dvd.dvd (Monoid.exponent f.range) 2 := by
    apply Monoid.exponent_dvd_of_forall_pow_eq_one
    intro v
    apply Subtype.ext
    choose u hu using v.property
    change v.val ^ 2 = (1 : G)
    rw [<- hu]
    change (u ^ (2 ^ (a + 1))) ^ 2 = 1
    rw [<- pow_mul, <- pow_succ]
    have h := Monoid.pow_exponent_eq_one u
    change u ^ (Monoid.exponent (Units (ZMod (2 ^ ((a + 1) + 3))))) = 1 at h
    rw [unit_exponent (a + 1)] at h
    exact h
  change Nat.card f.range <= 2
  rw [<- IsCyclic.exponent_eq_card]
  exact Nat.le_of_dvd (by decide : 0 < 2) hDiv

end PrimeFactorOscillations.TwoPowerCharacterConductor
